# Shared Caddyfile for Multiple Applications on Same EC2
# This replaces individual Caddy containers in each app

# Network App - Main domain
backintouch.net {
  handle /api/* {
    reverse_proxy localhost:3000 {
      health_uri /health
      health_interval 30s
    }
  }

  handle {
    root * /opt/network/frontend
    file_server
    try_files {path} /index.html
  }
}

www.backintouch.net {
  redir https://backintouch.net{uri} permanent
}

# ChoreTracker App - Subdomain
chores.backintouch.net {
  handle /api/* {
    reverse_proxy localhost:3001 {
      health_uri /health
      health_interval 30s
    }
  }

  handle {
    root * /opt/chore-tracker/frontend
    file_server
    try_files {path} /index.html
  }
}

# Fallback for IP access (HTTP only)
:80 {
  respond "Please use backintouch.net or chores.backintouch.net"
}
